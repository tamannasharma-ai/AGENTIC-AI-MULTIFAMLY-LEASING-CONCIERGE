SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Optional. Leave blank for calendar downloads without email.
RESEND_API_KEY=
# Optional market context only; not needed for the leasing demo.
RENTCAST_API_KEY=
# Anonymous operational analytics in the existing PostgreSQL database.
ANALYTICS_ENABLED=true
# Keep this fictional community on demo. Never mix tests with live traffic.
ANALYTICS_MODE=demo
# Staff reset and aggregate metrics require demo mode AND a loopback listener.
DEMO_CONTROLS=true
